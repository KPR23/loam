#include "Config.xcconfig"

// Account switching is available only when all three guards agree:
// a DEBUG build, testing environment, and this exact allowlisted project URL.
LOAM_ENVIRONMENT = testing
LOAM_TEST_SUPABASE_URL = https:/$()/iazyvupjvtuiezugurvo.supabase.co

LOAM_TEST_JULIA_USER_ID =
LOAM_TEST_JULIA_EMAIL =
LOAM_TEST_JULIA_PASSWORD =
LOAM_TEST_PHILIP_USER_ID =
LOAM_TEST_PHILIP_EMAIL =
LOAM_TEST_PHILIP_PASSWORD =

// Local credentials belong in this ignored file. Keeping the include last lets
// local values override the safe empty defaults above.
#include? "Secrets.xcconfig"
