// Fill in real values from Supabase → Project Settings → API.
// IMPORTANT: xcconfig treats // as a comment. Use https:/$()/… not https://…
//
// Use the anon / publishable key (eyJ… or sb_publishable_…).
// Do NOT use sb_secret_… / service_role — that key must never ship in the app.

SUPABASE_URL = https:/$()/YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = your-anon-key
