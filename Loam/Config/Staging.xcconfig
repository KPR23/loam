// Staging Supabase project used by Debug and TestFlight builds.
// A separate app from the App Store one (its own App Store Connect record), so both install
// side by side. Debug overrides these again.
LOAM_BUNDLE_ID = app.loam.Loam.rc
LOAM_APP_ICON = AppIcon-RC
APP_DISPLAY_NAME = Loam RC
LOAM_SIRI_NAME = Loam RC
LOAM_SIRI_PRONUNCIATION = lohm R C
LOAM_ENVIRONMENT = staging
// No PostHog keys: only App Store builds send analytics, so the PostHog project holds real users only.
SENTRY_DSN = https:/$()/0e0e726194a581b5afab7405a491bb15@o4512135437942784.ingest.de.sentry.io/4512135445413968
SUPABASE_URL = https:/$()/iazyvupjvtuiezugurvo.supabase.co
SUPABASE_ANON_KEY = sb_publishable_EDBOAPJzAaWIO566_-3W5A_vMKI0JXd

// RevenueCat public Apple SDK key (appl_…). Left empty, purchases are off and
// every account stays on the free plan. Debug overrides it with the Test Store key.
// The App Store app's key can't be used here: its products belong to app.loam.Loam. To test
// purchases on TestFlight, add an app.loam.Loam.rc app in RevenueCat and put its key here.
REVENUECAT_API_KEY =
